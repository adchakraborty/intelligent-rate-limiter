        <mxCell id="legend" value="ALGORITHM OVERVIEW&#xa;&#xa;Data Structure:&#xa;surge_history[tenant,endpoint] = [&#xa;  {timestamp, rps, window: 30}&#xa;]&#xa;&#xa;Window Management:&#xa;• 5-minute rolling buffer (300s)&#xa;• Cleanup: now - 300 cutoff&#xa;• Per-tenant/endpoint tracking&#xa;&#xa;Trend Calculation:&#xa;trend = (last_rps - first_rps) / count&#xa;&#xa;Business Priority:&#xa;Free: 1.0, Pro: 2.0, Ent: 5.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="880" y="30" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="timing" value="TIMING &amp; EXECUTION&#xa;&#xa;Heuristic Loop: Every 1.5s&#xa;Data Window: 5 minutes (300s)&#xa;Data Points: ~10 points per window&#xa;Trend Analysis: Last 3 points&#xa;&#xa;Business Multiplier:&#xa;final_prob = base_prob * (0.8 + priority*0.15)&#xa;&#xa;Scaling Limits:&#xa;new_rps: min(500.0, current * factor)&#xa;new_burst: min(2000, burst * factor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="840" y="270" width="320" height="200" as="geometry" />
        </mxCell>
      </root>
