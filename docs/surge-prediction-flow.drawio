          </mxGeometry>
        </mxCell>
        <mxCell id="arrow4" value="0.2-2.0" style="endArrow=classic;html=1;rounded=0;" parent="1" source="classify" target="normal" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
