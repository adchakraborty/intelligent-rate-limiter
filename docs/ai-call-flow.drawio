        <mxCell id="loopIndicator" value="Continuous Loop&#xa;Every 1.5 seconds" style="curved=1;endArrow=classic;html=1;rounded=0;dashed=1;dashPattern=8 8;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="780" y="80" as="sourcePoint" />
            <mxPoint x="630" y="80" as="targetPoint" />
            <Array as="points">
              <mxPoint x="820" y="40" />
              <mxPoint x="820" y="120" />
              <mxPoint x="780" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
