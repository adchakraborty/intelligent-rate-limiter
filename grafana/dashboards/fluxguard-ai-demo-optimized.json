                {
                    "expr": "(sum(clamp_min(rl_real_time_rps{tenant=\"free\"} - 5, 0)) + sum(clamp_min(rl_real_time_rps{tenant=\"pro\"} - 10, 0)) + sum(clamp_min(rl_real_time_rps{tenant=\"ent\"} - 15, 0))) * 12",
