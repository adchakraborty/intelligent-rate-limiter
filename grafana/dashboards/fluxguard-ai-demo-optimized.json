{
    "id": null,
    "title": "🤖 FluxGuard AI Rate Limiter - Simple Dashboard",
    "tags": ["ai", "rate-limiting", "demo", "fluxguard"],
    "timezone": "browser",
    "refresh": "1s",
    "time": {
        "from": "now-5m",
        "to": "now"
    },
    "schemaVersion": 30,
    "version": 1,
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "hideControls": false,
    "links": [],
    "liveNow": true,
    "templating": {
        "list": []
    },
    "timepicker": {
        "refresh_intervals": ["1s", "2s", "5s", "10s"],
        "time_options": ["1m", "5m", "10m", "30m"]
    },
    "weekStart": "",
    "annotations": {
        "list": []
    },
    "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
    },
    "panels": [
        {
            "id": 1,
            "title": "📊 CURRENT TRAFFIC (RPS)",
            "description": "Live traffic hitting the backend",
            "type": "stat",
            "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
            "targets": [
                {
                    "expr": "rl_real_time_rps{tenant=\"free\"}",
                    "legendFormat": "🆓 Free Tier",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "rl_real_time_rps{tenant=\"pro\"}",
                    "legendFormat": "💼 Pro Tier",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "rl_real_time_rps{tenant=\"ent\"}",
                    "legendFormat": "🏆 Enterprise",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 1,
                    "custom": {"displayMode": "basic"}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "🆓 Free Tier"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
                    },
                    {
                        "matcher": {"id": "byName", "options": "💼 Pro Tier"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
                    },
                    {
                        "matcher": {"id": "byName", "options": "🏆 Enterprise"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]
                    }
                ]
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "textMode": "value_and_name"
            }
        },
        {
            "id": 2,
            "title": "🤖 AI DYNAMIC LIMITS",
            "description": "Current AI-adjusted rate limits",
            "type": "stat",
            "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
            "targets": [
                {
                    "expr": "max(rl_dynamic_limit{tenant=\"free\"}) or vector(8)",
                    "legendFormat": "Free AI Limit",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "max(rl_dynamic_limit{tenant=\"pro\"}) or vector(15)",
                    "legendFormat": "Pro AI Limit", 
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "max(rl_dynamic_limit{tenant=\"ent\"}) or vector(25)",
                    "legendFormat": "Enterprise AI Limit",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 0,
                    "custom": {"displayMode": "basic"}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "Free AI Limit"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "light-blue"}},
                            {"id": "custom.displayMode", "value": "lcd"},
                            {"id": "displayName", "value": "🆓 Free"}
                        ]
                    },
                    {
                        "matcher": {"id": "byName", "options": "Pro AI Limit"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "light-green"}},
                            {"id": "custom.displayMode", "value": "lcd"},
                            {"id": "displayName", "value": "💼 Pro"}
                        ]
                    },
                    {
                        "matcher": {"id": "byName", "options": "Enterprise AI Limit"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "light-purple"}},
                            {"id": "custom.displayMode", "value": "lcd"},
                            {"id": "displayName", "value": "🏆 Enterprise"}
                        ]
                    }
                ]
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "textMode": "value_and_name",
                "reduceOptions": {
                    "values": false,
                    "calcs": ["lastNotNull"],
                    "fields": ""
                }
            }
        },
        {
            "id": 3,
            "title": "🔒 STATIC LIMITS",
            "description": "Fixed static rate limits",
            "type": "stat",
            "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
            "targets": [
                {
                    "expr": "5",
                    "legendFormat": "🆓 Free Static",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "10",
                    "legendFormat": "💼 Pro Static",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "15",
                    "legendFormat": "🏆 Enterprise Static",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 0,
                    "custom": {"displayMode": "basic"}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "🆓 Free Static"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
                    },
                    {
                        "matcher": {"id": "byName", "options": "💼 Pro Static"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
                    },
                    {
                        "matcher": {"id": "byName", "options": "🏆 Enterprise Static"},
                        "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
                    }
                ]
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "textMode": "value_and_name"
            }
        },
        {
            "id": 4,
            "title": "⚖️ GOVERNANCE QUEUE",
            "description": "Items waiting for approval and auto-approved decisions",
            "type": "stat",
            "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
            "targets": [
                {
                    "expr": "rl_governance_queue_size or vector(0)",
                    "legendFormat": "⏳ Pending Items",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "sum(rate(rl_governance_auto_approvals_total[1m])) * 60 or vector(0)",
                    "legendFormat": "✅ Auto-Approvals/min",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "decimals": 0,
                    "custom": {"displayMode": "basic"}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "⏳ Pending Items"},
                        "properties": [
                            {"id": "color", "value": {"mode": "thresholds"}},
                            {"id": "thresholds", "value": {
                                "steps": [
                                    {"color": "#56A64B", "value": 0},
                                    {"color": "#FF9830", "value": 3},
                                    {"color": "#F2495C", "value": 8},
                                    {"color": "#8B0000", "value": 15}
                                ]
                            }}
                        ]
                    },
                    {
                        "matcher": {"id": "byName", "options": "✅ Auto-Approvals/min"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "#37872D"}}
                        ]
                    }
                ]
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "textMode": "value_and_name"
            }
        },
        {
            "id": 6,
            "title": "🛡️ AI PROTECTION (Saves/Min)",
            "description": "Requests saved by AI dynamic limits vs static limits",
            "type": "stat",
            "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
            "targets": [
                {
                    "expr": "max(rate(rl_ai_saves_total{tenant=\"free\"}[1m])) * 60 or vector(0)",
                    "legendFormat": "Free Saves",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "max(rate(rl_ai_saves_total{tenant=\"pro\"}[1m])) * 60 or vector(0)",
                    "legendFormat": "Pro Saves",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "max(rate(rl_ai_saves_total{tenant=\"ent\"}[1m])) * 60 or vector(0)",
                    "legendFormat": "Enterprise Saves",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "decimals": 0,
                    "custom": {"displayMode": "lcd"}
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "Free Saves"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "#73BF69"}},
                            {"id": "displayName", "value": "🆓 Free"}
                        ]
                    },
                    {
                        "matcher": {"id": "byName", "options": "Pro Saves"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "#56A64B"}},
                            {"id": "displayName", "value": "💼 Pro"}
                        ]
                    },
                    {
                        "matcher": {"id": "byName", "options": "Enterprise Saves"},
                        "properties": [
                            {"id": "color", "value": {"mode": "fixed", "fixedColor": "#37872D"}},
                            {"id": "displayName", "value": "🏆 Enterprise"}
                        ]
                    }
                ]
            },
            "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "textMode": "value_and_name",
                "reduceOptions": {
                    "values": false,
                    "calcs": ["lastNotNull"],
                    "fields": ""
                }
            }
        },
        {
            "id": 5,
            "title": "📈 TRAFFIC SURGE PREDICTION",
            "description": "AI monitors traffic patterns and predicts surge probability over time",
            "type": "timeseries",
            "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
            "targets": [
                {
                    "expr": "clamp_min(clamp_max(rl_surge_prediction or vector(0.05), 1.0), 0.0)",
                    "legendFormat": "🚨 Surge Risk Level",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1,
                    "decimals": 2,
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "fillOpacity": 20,
                        "gradientMode": "hue",
                        "spanNulls": false,
                        "insertNulls": false,
                        "showPoints": "auto",
                        "pointSize": 5,
                        "stacking": {"mode": "none", "group": "A"},
                        "axisPlacement": "auto",
                        "axisLabel": "",
                        "axisColorMode": "text",
                        "scaleDistribution": {"type": "linear"},
                        "axisCenteredZero": false,
                        "hideFrom": {"legend": false, "tooltip": false, "vis": false},
                        "thresholdsStyle": {"mode": "off"}
                    }
                },
                "overrides": [
                    {
                        "matcher": {"id": "byName", "options": "🚨 Surge Risk Level"},
                        "properties": [
                            {"id": "color", "value": {"mode": "palette-classic"}},
                            {"id": "custom.fillOpacity", "value": 25}
                        ]
                    }
                ]
            },
            "options": {
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                },
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true,
                    "values": ["current", "max"]
                }
            }
        }
    ]
}