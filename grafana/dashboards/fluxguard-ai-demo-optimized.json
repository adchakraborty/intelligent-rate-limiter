                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "rl_real_time_rps{tenant=\"ent\"}",
                    "legendFormat": "Enterprise Current Traffic",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
