                    "legendFormat": "Pro AI Current Limit",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "rl_dynamic_limit{tenant=\"ent\"} or (15 + (rl_demo_phase * 8) + sin(vector(time() / 30)) * 4)",
                    "legendFormat": "Enterprise AI Current Limit",
