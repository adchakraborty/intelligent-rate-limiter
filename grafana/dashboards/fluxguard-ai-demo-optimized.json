                {
                    "expr": "10", 
                    "legendFormat": "Pro Static Baseline",
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "15",
                    "legendFormat": "Enterprise Static Baseline", 
                    "datasource": {"type": "prometheus", "uid": "prometheus"}
                },
                {
                    "expr": "rl_dynamic_limit{tenant=\"free\"} or (5 + (rl_demo_phase * 3) + sin(vector(time() / 20)) * 2)",
